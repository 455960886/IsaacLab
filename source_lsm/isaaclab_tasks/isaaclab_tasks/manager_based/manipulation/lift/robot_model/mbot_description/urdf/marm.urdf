<?xml version="1.0" ?>
<robot name="marm">

<!-- /    COLOR    / -->
	<material name="Black">
		<color rgba="0.0 0.0 0.0 1.0"/>
	</material>
	<material name="White">
		<color rgba="1.0 1.0 1.0 1.0"/>
	</material>
	<material name="Blue">
		<color rgba="0.0 0.0 0.9 1.0"/>
	</material>
	<material name="Red">
		<color rgba="1.0 0.0 0.0 1.0"/>
	</material>

<!-- /    BASE    / -->
	<link name="base_link">
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<cylinder length="0.04" radius="0.05"/>
			</geometry>
			<material name="White"/>
		</visual>
		<collision>
		    <origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
        		<cylinder length="0.04" radius="0.05"/>
        	</geometry>
		</collision>
		<inertial>
		    <mass value="10"/>
		    <inertia ixx="0.0076" ixy="0.0" ixz="0.0" iyy="0.0076" iyz="0.0" izz="0.0125"/>
		</inertial>
	</link>

<!-- /   LINK1  // -->
	<link name="link1">
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0.07"/>
			<geometry>
				<cylinder length="0.1" radius="0.03"/>
			</geometry>
			<material name="Blue"/>
		</visual>
		<collision>
		    <origin rpy="0 0 0" xyz="0 0 0.07"/>
		    <geometry>
            	<cylinder length="0.1" radius="0.03"/>
            </geometry>
		</collision>
		<inertial>
		    <mass value="10"/>
		    <inertia ixx="0.0106" ixy="0.0" ixz="0.0" iyy="0.0106" iyz="0.0" izz="0.0045"/>
		</inertial>
	</link>

	<joint name="joint1" type="revolute">
		<parent link="base_link"/>
		<child link="link1"/>
		<origin rpy="0 0 0" xyz="0 0 0"/>
		<axis xyz="0 0 1"/>
		<limit effort="300" lower="-3.14159" upper="3.14159" velocity="0"/>
	</joint>


<!-- ///   LINK2  // -->
	<link name="link2">
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0.07"/>
			<geometry>
				<cylinder length="0.14" radius="0.03"/>
			</geometry>
			<material name="White"/>
		</visual>
		<collision>
		    <origin rpy="0 0 0" xyz="0 0 0.07"/>
		    <geometry>
        		<cylinder length="0.14" radius="0.03"/>
        	</geometry>
		</collision>
		<inertial>
		    <mass value="10"/>
            <inertia ixx="0.0186" ixy="0.0" ixz="0.0" iyy="0.0186" iyz="0.0" izz="0.0045"/>
		</inertial>
	</link>

	<joint name="joint2" type="revolute">
		<parent link="link1"/>
		<child link="link2"/>
		<origin rpy="0 0 0" xyz="0 0 0.12"/>
		<axis xyz="1 0 0"/>
		<limit effort="300" lower="-3.14159" upper="3.14159" velocity="0"/>
	</joint>

<!-- /   LINK3  / -->
	<link name="link3">
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0.075"/>
			<geometry>
				<cylinder length="0.15" radius="0.03"/>
			</geometry>
			<material name="Blue"/>
		</visual>
		<collision>
		    <origin rpy="0 0 0" xyz="0 0 0.075"/>
		    <geometry>
        		<cylinder length="0.15" radius="0.03"/>
        	</geometry>
		</collision>
		<inertial>
		    <mass value="10"/>
            <inertia ixx="0.021" ixy="0.0" ixz="0.0" iyy="0.021" iyz="0.0" izz="0.0045"/>
		</inertial>
	</link>

	<joint name="joint3" type="revolute">
		<parent link="link2"/>
		<child link="link3"/>
		<origin rpy="0 0 0" xyz="0 0 0.14"/>
		<axis xyz="-1 0 0"/>
		<limit effort="300" lower="-3.14159" upper="3.14159" velocity="0"/>
	</joint>



<!--    LINK6  / -->
	<link name="link6">
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0.01"/>
			<geometry>
				<cylinder length="0.02" radius="0.04"/>
			</geometry>
			<material name="Blue"/>
		</visual>
		<collision>
			<origin rpy="0 0 0" xyz="0 0 0.01"/>
		    <geometry>
        		<cylinder length="0.02" radius="0.04"/>
        	</geometry>
		</collision>
		<inertial>
            <mass value="10"/>
            <inertia ixx="0.0043" ixy="0.0" ixz="0.0" iyy="0.0043" iyz="0.0" izz="0.0032"/>
        </inertial>
	</link>

	<joint name="joint6" type="revolute">
		<parent link="link3"/>
		<child link="link6"/>
		<origin rpy="0 0 0" xyz="0 0 0.15"/>
		<axis xyz="0 0 1"/>
		<limit effort="300" lower="-6.28318" upper="6.28318" velocity="0"/>
	</joint>

<!-- //   GRIPPER   // -->
	<link name="gripper_finger_link1">
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0.03"/>
			<geometry>
				<box size="0.03 0.01 0.06"/>
			</geometry>
			<material name="White"/>
		</visual>
		<collision>
		    <origin rpy="0 0 0" xyz="0 0 0.03"/>
			<geometry>
        		<box size="0.03 0.01 0.06"/>
        	</geometry>
		</collision>
	    <inertial>
            <mass value="10"/>
            <inertia ixx="0.0031" ixy="0.0" ixz="0.0" iyy="0.00375" iyz="0.0" izz="0.00083"/>
        </inertial>
	</link>

	<link name="gripper_finger_link2">
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0.03"/>
			<geometry>
				<box size="0.03 0.01 0.06"/>
			</geometry>
			<material name="White"/>
		</visual>
		<collision>
		    <origin rpy="0 0 0" xyz="0 0 0.03"/>
			<geometry>
                <box size="0.03 0.01 0.06"/>
            </geometry>
		</collision>
	    <inertial>
            <mass value="10"/>
            <inertia ixx="0.0031" ixy="0.0" ixz="0.0" iyy="0.00375" iyz="0.0" izz="0.00083"/>
        </inertial>
	</link>

	<joint name="finger_joint1" type="prismatic">
		<parent link="link6"/>
		<child link="gripper_finger_link1"/>
		<origin rpy="0 0 0" xyz="0 -0.03 0.02"/>
		<axis xyz="0 1 0"/>
		<limit effort="100" lower="0" upper="0.06" velocity="0"/>
	</joint>

	<joint name="finger_joint2" type="fixed">
		<parent link="link6"/>
		<child link="gripper_finger_link2"/>
		<origin rpy="0 0 0" xyz="0 0.03 0.02"/>
	</joint>

<!-- //   GRASPING FRAME   // -->
	<link name="grasping_frame"/>

	<joint name="grasping_frame_joint" type="fixed">
		<parent link="link6"/>
		<child link="grasping_frame"/>
		<origin rpy="0 0 0" xyz="0.06 0 0"/>
	</joint>



</robot>